---
// AlbanilAnimation.astro
// SVG animado ligero: albañil poniendo un ladrillo en un muro.
// Optimizado para conexión lenta (Cuba): todo es CSS, no JS, no imágenes externas.
// Animación en bucle ~2.4s, sin will-change permanente, sin parallax, sin filtros.
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div
  class:list={['albanil-wrap', className]}
  role="img"
  aria-label="Albañil OBrava poniendo un ladrillo — la brigada que sí aparece"
>
  <svg viewBox="0 0 300 350" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    {/* Suelo / base de la obra */}
    <rect x="0" y="300" width="300" height="50" fill="#0d0d0d" />
    <line x1="20" y1="300" x2="280" y2="300" stroke="#F26522" stroke-width="2" />

    {/* Sol tropical girando */}
    <g class="sun">
      <circle cx="50" cy="50" r="15" fill="#F26522" opacity="0.9" />
      <g stroke="#F26522" stroke-width="2" opacity="0.45" stroke-linecap="round">
        <line x1="50" y1="22" x2="50" y2="32" />
        <line x1="50" y1="68" x2="50" y2="78" />
        <line x1="22" y1="50" x2="32" y2="50" />
        <line x1="68" y1="50" x2="78" y2="50" />
        <line x1="30" y1="30" x2="37" y2="37" />
        <line x1="63" y1="63" x2="70" y2="70" />
        <line x1="30" y1="70" x2="37" y2="63" />
        <line x1="63" y1="37" x2="70" y2="30" />
      </g>
    </g>

    {/* Muro existente (a la derecha) */}
    <rect x="180" y="240" width="80" height="60" fill="#1a1a1a" />
    <rect x="180" y="240" width="40" height="30" fill="#262626" stroke="#333" />
    <rect x="220" y="240" width="40" height="30" fill="#262626" stroke="#333" />
    <rect x="200" y="270" width="40" height="30" fill="#2a2a2a" stroke="#444" />

    {/* Ladrillo cayendo y poniéndose (animado) */}
    <g class="brick">
      <rect x="180" y="270" width="40" height="30" fill="#C0392B" stroke="#E74C3C" />
    </g>

    {/* Albañil */}
    <g class="worker">
      {/* Piernas */}
      <rect x="105" y="270" width="12" height="30" fill="#2c3e50" />
      <rect x="125" y="270" width="12" height="30" fill="#2c3e50" />
      {/* Torso (camisa de trabajo) */}
      <rect x="100" y="220" width="40" height="55" fill="#2c3e50" rx="5" />
      {/* Franjas reflectivas naranjas */}
      <rect x="100" y="235" width="40" height="4" fill="#F26522" opacity="0.9" />
      <rect x="100" y="255" width="40" height="4" fill="#F26522" opacity="0.9" />
      {/* Cuello */}
      <rect x="115" y="210" width="10" height="15" fill="#8D5524" />
      {/* Cabeza (piel canela) */}
      <circle cx="120" cy="195" r="18" fill="#8D5524" />
      {/* Casco de construcción naranja */}
      <path d="M100 195 Q120 165 140 195 L140 190 Q120 160 100 190 Z" fill="#F26522" />
      <rect x="98" y="190" width="44" height="6" fill="#F26522" rx="3" />
    </g>

    {/* Brazo con llana (animado) */}
    <g class="arm">
      <rect x="130" y="225" width="30" height="12" fill="#8D5524" rx="6" />
      <rect x="160" y="222" width="15" height="10" fill="#444" rx="2" />
      <path d="M175 218 L195 218 L190 232 L170 232 Z" fill="#dddddd" />
    </g>
  </svg>
</div>

<style>
  .albanil-wrap {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    aspect-ratio: 300 / 350;
  }
  .albanil-wrap svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Animaciones CSS — livianas, sin filtros, sin blur */
  .sun {
    transform-origin: 50px 50px;
    animation: albanil-spin 24s linear infinite;
  }
  .arm {
    transform-origin: 130px 230px;
    animation: albanil-arm 2.4s ease-in-out infinite;
  }
  .brick {
    transform-origin: center;
    animation: albanil-brick 2.4s ease-in infinite;
    opacity: 0;
  }

  @keyframes albanil-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes albanil-arm {
    0%, 100% { transform: rotate(0deg); }
    50%      { transform: rotate(-22deg); }
  }
  @keyframes albanil-brick {
    0%   { transform: translateY(-30px); opacity: 0; }
    25%  { transform: translateY(0);     opacity: 1; }
    80%  { transform: translateY(0);     opacity: 1; }
    100% { transform: translateY(0);     opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sun, .arm, .brick { animation: none; }
    .brick { opacity: 1; }
  }
</style>
