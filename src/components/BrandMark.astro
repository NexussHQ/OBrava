---
// BrandMark.astro
// Logo integrado: [monograma 3D] + "OB" (ladrillo) + "RAVA" (blanco)
// Usado en Header y Footer, en lugar de imágenes PNG.
// Tamaños: sm (header mobile), md (header desktop), lg (footer)
import OBMonogram from './OBMonogram.astro';

export interface Props {
  size?: 'sm' | 'md' | 'lg';
  showWordmark?: boolean;
  className?: string;
}

const { size = 'md', showWordmark = true, className = '' } = Astro.props;

const sizeMap = {
  sm: { monogram: 36, text: 'text-xl sm:text-2xl', gap: 'gap-2' },
  md: { monogram: 48, text: 'text-2xl sm:text-3xl', gap: 'gap-3' },
  lg: { monogram: 64, text: 'text-3xl sm:text-4xl md:text-5xl', gap: 'gap-3 sm:gap-4' },
} as const;
const cfg = sizeMap[size];
---

<a
  href="/"
  class:list={['brand-mark group inline-flex items-center shrink-0', cfg.gap, className]}
  aria-label="OBrava · Inicio"
>
  <OBMonogram variant="logo" size={cfg.monogram} />
  {showWordmark && (
    <span
      class:list={[
        'font-display font-black tracking-tight leading-none uppercase whitespace-nowrap',
        cfg.text,
      ]}
    >
      <span class="text-obrava-orange">OB</span><span class="text-obrava-white">RAVA</span>
    </span>
  )}
</a>
