---
// BrandMark.astro
// Logo integrado para Header y Footer.
// Render: [monograma 3D PNG recortado, sin texto] + "OB" (ladrillo) + "RAVA" (blanco)
// Centrado vertical con flex items-center + línea-baseline del texto alineada al monograma.
import monogramMark from '../assets/logos/ob-monogram-3d-mark.png';

export interface Props {
  size?: 'sm' | 'md' | 'lg';
  showWordmark?: boolean;
  className?: string;
}

const { size = 'md', showWordmark = true, className = '' } = Astro.props;

// Altura del monograma PNG (ratio 1024:645 = ~1.587:1)
// El texto se alinea con items-center. Como el texto Inter Black uppercase
// tiene ascent alto, usamos baseline-shift/translate para que el centro
// visual del texto coincida con el centro del monograma.
const sizeMap = {
  sm: { height: 40,  text: 'text-xl',          textOffsetY: -2 },
  md: { height: 56,  text: 'text-2xl sm:text-3xl', textOffsetY: -3 },
  lg: { height: 88,  text: 'text-3xl sm:text-4xl md:text-5xl', textOffsetY: -5 },
} as const;
const cfg = sizeMap[size];
---

<a
  href="/"
  class:list={['brand-mark group inline-flex items-center shrink-0 gap-2 sm:gap-3', className]}
  aria-label="OBrava · Inicio"
>
  <img
    src={monogramMark.src}
    alt="Monograma OB · ObraBrava"
    class="block w-auto"
    style={`height: ${cfg.height}px;`}
    width={monogramMark.width}
    height={monogramMark.height}
    decoding="async"
    loading="eager"
  />
  {showWordmark && (
    <span
      class:list={[
        'font-display font-black tracking-tight leading-[0.85] uppercase whitespace-nowrap',
        cfg.text,
      ]}
      style={`transform: translateY(${cfg.textOffsetY}px);`}
    >
      <span class="text-obrava-orange">OB</span><span class="text-obrava-white">RAVA</span>
    </span>
  )}
</a>
