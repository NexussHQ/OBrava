---
// Header.astro
// Nav fixed neo-brutalista: borde 8px orange, wordmark + links + CTA WhatsApp
import OBMonogram from './OBMonogram.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];

const whatsappHref = 'https://wa.me/5352622265?text=Hola%20OBrava%2C%20necesito%20un%20servicio';
---

<header class="fixed top-0 w-full z-50 bg-obrava-black border-b-8 border-obrava-orange">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <a href="/" class="flex items-center gap-3 group" aria-label="OBrava · Inicio">
        <OBMonogram variant="mark" size={48} className="shrink-0" />
        <span class="hidden md:inline-block text-obrava-orange font-display font-black text-2xl uppercase tracking-tight group-hover:translate-x-1 transition-transform">
          OB<span class="text-obrava-white">RAVA</span>
        </span>
      </a>

      <nav class="hidden md:flex gap-8" aria-label="Navegación principal">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'text-sm font-bold border-b-4 transition-colors uppercase',
              isActive(href)
                ? 'border-obrava-orange text-obrava-orange'
                : 'border-transparent text-obrava-white hover:border-obrava-orange',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={whatsappHref}
          class="bg-obrava-orange text-obrava-black px-4 sm:px-6 py-2.5 font-black border-4 border-obrava-orange shadow-brutal-white hover:shadow-brutal-small-white hover:translate-x-1 hover:translate-y-1 transition-all flex items-center gap-2 text-xs sm:text-sm uppercase tracking-wider"
          aria-label="Contactar por WhatsApp"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          <span class="hidden sm:inline">WhatsApp</span>
        </a>

        <button
          id="menu-toggle"
          class="md:hidden text-obrava-white hover:text-obrava-orange transition-colors p-2"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden hidden bg-obrava-black border-t-4 border-obrava-orange"
  >
    <nav class="max-w-7xl mx-auto px-4 py-6 space-y-4" aria-label="Navegación móvil">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'block text-lg font-bold uppercase border-l-4 pl-4 py-2',
            isActive(href)
              ? 'border-obrava-orange text-obrava-orange'
              : 'border-transparent text-obrava-white hover:border-obrava-orange',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    });
  }
</script>
