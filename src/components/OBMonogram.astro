---
// OBMonogram.astro
// Monograma OB estilo neo-brutalista reconstruido en SVG puro.
// Especificaciones del manual de marca:
// - Construction Orange (#F26522) y Deep Charcoal (#000000)
// - Bordes afilados (radius 0)
// - Bloques estructurales entrelazados O y B
// - Sin gradientes, sin sombras suaves
export interface Props {
  size?: number;
  variant?: 'logo' | 'favicon' | 'wordmark' | 'mark';
  className?: string;
}

const { size = 200, variant = 'logo', className = '' } = Astro.props;
---

{variant === 'wordmark' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 360 80"
    width={size * 1.8}
    height={size * 0.4}
    class={className}
    aria-label="OBrava"
  >
    <rect width="360" height="80" fill="#000000" />
    <text
      x="180"
      y="58"
      font-size="50"
      font-weight="900"
      text-anchor="middle"
      fill="#f26522"
      font-family="Inter, sans-serif"
      letter-spacing="-2"
    >OBRAVA</text>
  </svg>
)}

{variant === 'logo' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 200 200"
    width={size}
    height={size}
    class={className}
    aria-label="OBrava monogram"
  >
    {/* Background block — deep charcoal */}
    <rect width="200" height="200" fill="#000000" />
    {/* O block — left orange */}
    <g>
      <rect x="20" y="20" width="80" height="160" fill="#f26522" />
      <rect x="44" y="44" width="32" height="112" fill="#000000" />
    </g>
    {/* B block — right orange with two cutouts */}
    <g>
      <rect x="100" y="20" width="80" height="160" fill="#f26522" />
      <rect x="124" y="44" width="32" height="44" fill="#000000" />
      <rect x="124" y="112" width="32" height="44" fill="#000000" />
    </g>
    {/* Hard offset accent — top-right + bottom-left */}
    <rect x="184" y="0" width="16" height="16" fill="#f26522" />
    <rect x="0" y="184" width="16" height="16" fill="#f26522" />
  </svg>
)}

{variant === 'mark' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    width={size}
    height={size}
    class={className}
    aria-label="OB"
  >
    <rect width="64" height="64" fill="#000000" />
    <rect x="6" y="6" width="26" height="52" fill="#f26522" />
    <rect x="13" y="13" width="12" height="38" fill="#000000" />
    <rect x="32" y="6" width="26" height="52" fill="#f26522" />
    <rect x="39" y="13" width="12" height="14" fill="#000000" />
    <rect x="39" y="29" width="12" height="14" fill="#000000" />
  </svg>
)}

{variant === 'favicon' && (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    width={size}
    height={size}
    class={className}
    aria-label="OBrava"
  >
    <rect width="64" height="64" fill="#000000" />
    <rect x="6" y="6" width="26" height="52" fill="#f26522" />
    <rect x="13" y="13" width="12" height="38" fill="#000000" />
    <rect x="32" y="6" width="26" height="52" fill="#f26522" />
    <rect x="39" y="13" width="12" height="14" fill="#000000" />
    <rect x="39" y="29" width="12" height="14" fill="#000000" />
  </svg>
)}

<style>
  svg { display: block; }
</style>
