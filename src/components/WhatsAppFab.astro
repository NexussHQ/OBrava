---
// WhatsAppFab.astro
// Botón flotante WhatsApp (FAB) — bottom-right fijo en todo el sitio.
// Animaciones: pulse + wiggle de entrada + float + halo expand.
export interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = '5352622265',
  message = 'Hola OBrava, necesito un servicio',
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp"
  data-wa-fab
>
  <span class="wa-fab-ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </span>
  <span class="wa-fab-label">WhatsApp</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 60px;
    padding: 0 22px 0 16px;
    background: #f26522;
    color: #000000;
    border: 4px solid #000000;
    border-radius: 9999px !important;
    box-shadow: 6px 6px 0 0 #000000;
    text-decoration: none;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: transform 180ms ease-out, box-shadow 180ms ease-out;
  }
  .wa-fab:hover,
  .wa-fab:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 0 #000000;
    color: #000000;
  }
  .wa-fab:active {
    transform: translate(1px, 1px);
    box-shadow: 3px 3px 0 0 #000000;
  }
  .wa-fab-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    color: #000000;
  }
  .wa-fab-label {
    line-height: 1;
  }

  @media (max-width: 480px) {
    .wa-fab {
      height: 56px;
      padding: 0;
      width: 56px;
      right: 14px;
      bottom: 14px;
      font-size: 12px;
    }
    .wa-fab-label { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-fab { transition: none; }
  }
</style>
