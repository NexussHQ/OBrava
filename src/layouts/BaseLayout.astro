---
// BaseLayout.astro
// Layout principal del sitio OBrava
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import Reveal from '../components/Reveal.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  hideFab?: boolean;
}

const {
  title,
  description = 'OBrava · Brigada de construcción en La Habana, Cuba. Presupuesto claro, fecha cierta, garantía escrita. La brigada que sí aparece.',
  ogImage = '/og-image.png',
  noindex = false,
  hideFab = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === 'OBrava' ? title : `${title} · OBrava`;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f26522" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="es_CU" />
    <meta property="og:site_name" content="OBrava" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data · LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'GeneralContractor',
      name: 'OBrava',
      description: 'Brigada de construcción en La Habana, Cuba. Reformas, reparaciones y obras con presupuesto claro, fecha cierta y garantía escrita.',
      url: Astro.site?.toString(),
      telephone: '+5352622265',
      email: 'sandyllerena77@gmail.com',
      image: new URL(ogImage, Astro.site).toString(),
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'La Habana',
        addressCountry: 'CU',
      },
      areaServed: { '@type': 'City', name: 'La Habana' },
      priceRange: 'CUP / USD',
      slogan: 'La brigada que sí aparece',
      sameAs: [
        'https://wa.me/5352622265',
      ],
    })} />
  </head>
  <body class="bg-obrava-black text-obrava-white font-body antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-obrava-orange focus:text-obrava-black focus:px-4 focus:py-2 focus:font-display focus:font-bold focus:border-4 focus:border-obrava-black"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <main id="main" class="pt-20">
      <slot />
    </main>

    <Footer />

    {!hideFab && <WhatsAppFab />}

    <Reveal />
  </body>
</html>
