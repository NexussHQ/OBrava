          <p class="text-base sm:text-xl text-obrava-white font-display font-bold max-w-xl" data-reveal="fade-up" data-reveal-delay="200">
            Gana puntos, descuentos y beneficios exclusivos por confiar y recomendar. Sin tarjeta, sin app — te los descuenta tu socio administrador cuando vuelvas.
          </p>
        </div>
        <div class="bg-obrava-gray border-4 border-obrava-orange shadow-brutal p-5 sm:p-8" data-reveal="fade-left" data-reveal-duration="900">
          <div class="space-y-0 divide-y-2 divide-obrava-silver">
            {puntos.map((p) => (
              <div class="flex justify-between items-center py-3 sm:py-4 gap-3">
                <span class="font-mono text-xs sm:text-sm uppercase tracking-wider text-obrava-orange">
                  {p.copy}
                </span>
                <span class="font-display font-black text-lg sm:text-2xl text-obrava-white whitespace-nowrap">
                  {p.num}
                </span>
              </div>
            ))}
          </div>
          <a
            href={whatsappLink('Hola, quiero ser parte del programa Embajadores OBrava')}
            class="mt-5 sm:mt-6 inline-flex items-center justify-center w-full bg-obrava-orange text-obrava-black font-display font-black uppercase tracking-wider px-6 py-3 border-4 border-obrava-orange shadow-brutal-white hover:shadow-brutal-small-white hover:translate-x-1 hover:translate-y-1 transition-all text-sm"
          >
            Empezar a ganar puntos →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============== FAQ ============== -->
  <section class="section bg-obrava-gray" id="faq">
    <div class="container-brand max-w-4xl">
      <div class="text-center mb-10 sm:mb-16">
        <span class="eyebrow" data-reveal="pop">Dudas frecuentes</span>
        <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-3 sm:mb-4 text-obrava-orange text-balance" data-reveal="fade-up" data-reveal-delay="100">
