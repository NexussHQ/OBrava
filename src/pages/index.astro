---
// src/pages/index.astro
// OBrava · Landing principal (v2)
// Estructura editorial: Masthead → Promesas → 4 Servicios (split diptych) →
// Proceso → Mantenimiento → Puntos Embajadores → FAQ (6) → CTA final.
import BaseLayout from '../layouts/BaseLayout.astro';
import OBMonogram from '../components/OBMonogram.astro';
import monogram3d from '../assets/logos/ob-monogram-3d.png';

const whatsappLink = (msg: string) =>
  `https://wa.me/5352622265?text=${encodeURIComponent(msg)}`;

// === HERO (masthead) ===
const heroWhatsapp = whatsappLink('Hola OBrava, quiero pedir un presupuesto');

// === PROMESAS ===
const promises = [
  {
    n: '01',
    title: 'Presupuesto claro',
    body: 'Cuánto cuesta, qué incluye y qué no. Por escrito. Sin sorpresas a mitad de obra.',
    highlight: false,
  },
  {
    n: '02',
    title: 'Fecha cierta',
    body: 'Cuándo empezamos y cuándo terminamos. Si nos pasamos, lo compensamos.',
    highlight: true,
  },
  {
    n: '03',
    title: 'Garantía escrita',
    body: '6 meses en mano de obra. 1 año en instalaciones. Si algo falla, volvemos sin coste.',
    highlight: false,
  },
];

// === SERVICIOS (4 paquetes · split diptych editorial) ===
type Service = {
  id: string;
  num: string;
  title: string;
  intro: string;
  specs: Array<[string, string]>;
  cta: string;
  proof: { kind: 'quote' | 'stat' | 'list'; quote?: string; attr?: string; stat?: string; statNote?: string; list?: string[] };
  flip: boolean;
  whatsappMsg: string;
};

const services: Service[] = [
  {
    id: 'manitas',
    num: '01',
    title: 'Manitas OBrava',
    intro: 'Para las reparaciones del día a día. Llegas, hablamos, lo arreglamos. Sin formulario, sin esperar tres semanas.',
    specs: [
      ['Plomería', '1 día'],
      ['Electricidad', '1 día'],
      ['Pintura (1 cuarto)', '1–2 días'],
      ['Cerraduras', 'medio día'],
    ],
    cta: 'Pedir Manitas',
    proof: {
      kind: 'quote',
      quote: 'Vinieron a cambiar el sifón el mismo día. Lo que otras cuadrillas habrían estirado toda la semana, OBrava lo resolvió en una mañana.',
      attr: 'Yudith P. · Centro Habana',
    },
    flip: false,
    whatsappMsg: 'Hola, necesito un Manitas OBrava',
  },
  {
    id: 'reforma',
    num: '02',
    title: 'Reforma OBrava',
    intro: 'Renovamos baño, cocina, habitación. Materiales incluidos según presupuesto. Te lo entregamos por escrito y por fotos.',
    specs: [
      ['Reforma de baño', '5–10 días'],
      ['Cocina', '1–2 semanas'],
      ['Pisos y Embaldosados', 'según m²'],
      ['Pintura interior', '3–7 días'],
    ],
    cta: 'Pedir Reforma',
    proof: {
      kind: 'stat',
      stat: '7 días',
      statNote: 'reforma de baño completa, sin retrasos',
    },
    flip: true,
    whatsappMsg: 'Hola, quiero reformar mi baño/cocina/habitación',
  },
  {
    id: 'ampliacion',
    num: '03',
    title: 'Ampliación OBrava',
    intro: 'Construimos el cuarto, balcón o segundo piso que tu familia necesita. Cimentación, obra gris, techo, instalaciones, entrega.',
    specs: [
      ['Cuarto', '3–5 semanas'],
      ['Balcón', '2–4 semanas'],
      ['Segundo piso', '2–4 meses'],
      ['Techo / cubierta', '1–3 semanas'],
    ],
    cta: 'Pedir Ampliación',
    proof: {
      kind: 'list',
      list: [
        'Cimentación según estudio de suelo',
        'Bloques, losa, instalaciones nuevas',
        'Permisos y normativas vigentes',
        'Garantía estructural de 5 años',
      ],
    },
    flip: false,
    whatsappMsg: 'Hola, quiero ampliar mi casa',
  },
  {
    id: 'llave-en-mano',
    num: '04',
    title: 'Llave en Mano',
    intro: 'Para MIPYMES, inversionistas, anfitriones de Airbnb. Entregamos un proyecto completo, hecho, listo para operar.',
    specs: [
      ['Local comercial', 'según proyecto'],
      ['Hostal / Airbnb', 'según proyecto'],
      ['Oficina', 'según proyecto'],
      ['Reforma integral vivienda', 'según proyecto'],
    ],
    cta: 'Pedir Llave en Mano',
    proof: {
      kind: 'quote',
      quote: 'Reformé la cocina entera. OBrava me enseñó cada paso con fotos. Sin sustos, sin extras. Recomendados 100%.',
      attr: 'Carlos M. · Playa',
    },
    flip: true,
    whatsappMsg: 'Hola, busco una obra llave en mano',
  },
];

// === PROCESO (4 pasos) ===
const steps = [
  { n: '01', title: 'Captación', body: 'Nos escribes por WhatsApp. Si tienes foto, mejor.', highlight: false },
  { n: '02', title: 'Visita', body: 'Vamos a la obra, medimos, evaluamos.', highlight: true },
  { n: '03', title: 'Cotización', body: 'Presupuesto por escrito. Sin compromiso.', highlight: false },
  { n: '04', title: 'Ejecución', body: 'Construimos en la fecha acordada.', highlight: false },
];

// === MANTENIMIENTO (Plan recurrente) ===
const mantenimiento = {
  whatsappMsg: 'Hola, me interesa un plan de mantenimiento OBrava',
  list: [
    'Visita programada cada mes',
    'Reparaciones menores incluidas',
    'Reporte fotográfico al cierre',
    'Atención prioritaria por WhatsApp',
  ],
};

// === PUNTOS EMBAJADORES (4 filas) ===
const puntos = [
  { num: '1 punto', copy: 'por cada 100 CUP gastados en una obra.' },
  { num: '+50 puntos', copy: 'por cada referido que cierre obra con nosotros.' },
  { num: '3× puntos', copy: 'en temporada baja (julio y agosto) para nivelar la demanda.' },
  { num: '5% off', copy: 'de por vida si traes a 5 amigos como Embajador OBrava.' },
];

// === FAQ (6 preguntas) ===
const faqs = [
  {
    q: '¿Cuánto cuesta la visita para cotizar?',
    a: 'La visita y el presupuesto son gratis y sin compromiso. Si decides no avanzar, no te cobramos nada. Si avanzamos, el costo de la visita se descuenta del total.',
  },
  {
    q: '¿Cómo se paga?',
    a: 'Aceptamos USD efectivo, CUP, Transfermóvil y remesas (Tropipay, Cuballama). Para obras grandes, 30 % anticipo + 50 % avance + 20 % entrega. Para arreglos chicos, pago al terminar.',
  },
  {
    q: '¿Cuánto demora una obra?',
    a: 'Depende del tamaño. Un arreglo de plomería: 1 día. Una reforma de baño: 5–10 días. Una reforma integral: 4–8 semanas. Te lo decimos claro en el presupuesto.',
  },
  {
    q: '¿Y si tengo un problema después de la obra?',
    a: 'Activamos la garantía OBrava: 6 meses en mano de obra, 1 año en instalaciones. Volvemos sin coste. Sin letra pequeña.',
  },
  {
    q: '¿Trabajan en toda La Habana?',
    a: 'Sí. Toda La Habana y municipios cercanos. Para zonas más alejadas, consultamos.',
  },
  {
    q: '¿Y los materiales?',
    a: 'Dos opciones: (1) los compras tú y nosotros los usamos, o (2) los compramos nosotros y te los pasamos al costo en el presupuesto. Recomendamos la opción 2 para que no pierdas tiempo.',
  },
];
---

<BaseLayout
  title="OBrava · La brigada que sí aparece"
  description="OBrava · Brigada de construcción en La Habana. Presupuesto claro, fecha cierta, garantía escrita. Manitas, Reforma, Ampliación y Llave en Mano. Escríbenos por WhatsApp: +53 526 222 65."
>

  <!-- ============== HERO · MASTHEAD ============== -->
  <section class="bg-obrava-black border-b-8 border-obrava-orange relative overflow-hidden">
    <div class="container-brand py-12 sm:py-16 lg:py-20 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 relative z-10">
        <span class="eyebrow">La brigada que sí aparece</span>
        <h1 class="text-5xl sm:text-6xl lg:text-8xl font-black tracking-tighter leading-[0.9] mb-6 sm:mb-8 text-balance">
          <span class="text-obrava-white">OB</span><span class="text-obrava-orange">RAVA.</span>
          <br />
          <span class="text-obrava-orange text-4xl sm:text-5xl lg:text-7xl">CUMPLIMOS.</span>
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl mb-8 sm:mb-10 text-obrava-white font-bold max-w-xl leading-snug">
          Presupuesto claro. Fecha cierta. Garantía escrita. Sin excusas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={heroWhatsapp} class="btn-primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir Presupuesto Gratis
          </a>
          <a href="#servicios" class="btn-secondary">Ver Servicios</a>
        </div>
        <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mt-6">
          Respondemos en menos de 2h · Visita gratis
        </p>
      </div>
      <div class="lg:col-span-5 hidden lg:flex justify-center items-center relative">
        <div class="border-8 border-obrava-orange shadow-brutal p-4 bg-obrava-black">
          <img
            src={monogram3d.src}
            alt="Monograma 3D OBrava — O naranja entrelazada con B de acero"
            class="w-full h-auto max-w-md"
            width={monogram3d.width}
            height={monogram3d.height}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="absolute -top-4 -right-4 hidden xl:block bg-obrava-orange text-obrava-black font-display font-black uppercase text-xs px-3 py-1 border-4 border-obrava-black shadow-brutal-white">
          La Habana · 2026
        </div>
      </div>
    </div>
  </section>

  <!-- ============== PROMESAS ============== -->
  <section class="section bg-obrava-gray" id="promesas">
    <div class="container-brand">
      <div class="text-center mb-12 sm:mb-16">
        <span class="eyebrow">Sin excusas</span>
        <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-4 text-obrava-orange text-balance">
          Nuestras Promesas
        </h2>
        <p class="text-obrava-white font-display font-bold text-lg sm:text-xl max-w-2xl mx-auto">
          Lo que decimos, lo firmamos. Lo que firmamos, lo cumplimos.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
        {promises.map((p) => (
          <div class:list={[
            'p-6 sm:p-8 border-4 transition-transform duration-150',
            p.highlight
              ? 'bg-obrava-orange text-obrava-black border-obrava-orange shadow-brutal-white md:-translate-y-2 hover:-translate-y-3'
              : 'bg-obrava-black text-obrava-white border-obrava-orange shadow-brutal hover:-translate-y-2',
          ]}>
            <div class:list={[
              'w-16 h-16 flex items-center justify-center mb-6 text-3xl font-display font-black border-4',
              p.highlight
                ? 'bg-obrava-black text-obrava-orange border-obrava-black'
                : 'bg-obrava-orange text-obrava-black border-obrava-orange',
            ]}>
              {p.n}
            </div>
            <h3 class:list={[
              'text-2xl sm:text-3xl font-display font-black mb-4 uppercase',
              p.highlight ? 'text-obrava-black' : 'text-obrava-white',
            ]}>{p.title}</h3>
            <p class:list={[
              'text-base sm:text-lg leading-relaxed font-display',
              p.highlight ? 'text-obrava-black font-bold' : 'text-obrava-white font-medium',
            ]}>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== SERVICIOS · SPLIT DIPTYCH ============== -->
  <section class="section bg-obrava-black" id="servicios">
    <div class="container-brand">
      <div class="mb-12 sm:mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="eyebrow">Lo que hacemos</span>
          <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-4 text-obrava-orange text-balance">
            Servicios Técnicos
          </h2>
          <p class="text-obrava-white font-display font-bold text-lg sm:text-xl max-w-2xl">
            Cinco paquetes. Todos con la misma promesa: presupuesto claro, fecha cierta, garantía escrita.
          </p>
        </div>
      </div>

      <div class="space-y-10 sm:space-y-12">
        {services.map((s) => (
          <article id={s.id} class:list={[
            'grid lg:grid-cols-2 gap-6 lg:gap-10 items-stretch',
            s.flip ? 'lg:[&>:first-child]:order-2' : '',
          ]}>
            {/* Texto del servicio */}
            <div class="bg-obrava-gray border-4 border-obrava-orange p-6 sm:p-8 shadow-brutal flex flex-col">
              <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-3">
                {s.num} · Servicio
              </p>
              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-black text-obrava-white uppercase mb-4">
                {s.title}
              </h3>
              <p class="text-base sm:text-lg text-obrava-white font-display font-medium leading-relaxed mb-6">
                {s.intro}
              </p>
              <ul class="spec-list">
                {s.specs.map(([label, value]) => (
                  <li>
                    <span>{label}</span>
                    <span>{value}</span>
                  </li>
                ))}
              </ul>
              <a
                href={whatsappLink(s.whatsappMsg)}
                class="btn-primary mt-6 self-start"
                aria-label={`Pedir ${s.title} por WhatsApp`}
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                {s.cta} →
              </a>
            </div>

            {/* Proof block */}
            <aside class="bg-obrava-orange text-obrava-black border-4 border-obrava-orange shadow-brutal p-6 sm:p-8 flex flex-col justify-center">
              {s.proof.kind === 'quote' && (
                <>
                  <p class="proof-quote">{s.proof.quote}</p>
                  <p class="proof-attr"><strong>{s.proof.attr}</strong></p>
                </>
              )}
              {s.proof.kind === 'stat' && (
                <div>
                  <p class="font-display font-black text-7xl lg:text-8xl leading-none text-obrava-black tracking-tighter">
                    {s.proof.stat}
                  </p>
                  <p class="font-display font-bold text-lg mt-4 max-w-sm">{s.proof.statNote}</p>
                </div>
              )}
              {s.proof.kind === 'list' && (
                <>
                  <p class="font-mono text-xs uppercase tracking-wider text-obrava-black mb-4">Incluye</p>
                  <ul class="space-y-3 font-display font-bold text-obrava-black text-lg">
                    {s.proof.list?.map((item) => (
                      <li class="flex items-start gap-3">
                        <span class="shrink-0 w-6 h-6 bg-obrava-black text-obrava-orange font-display font-black flex items-center justify-center mt-0.5">✓</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </aside>
          </article>
        ))}

        {/* Mantenimiento · 5to servicio en estilo split */}
        <article id="mantenimiento" class="grid lg:grid-cols-2 gap-6 lg:gap-10 items-stretch">
          <div class="bg-obrava-gray border-4 border-obrava-orange p-6 sm:p-8 shadow-brutal flex flex-col">
            <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-3">
              05 · Plan recurrente
            </p>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-display font-black text-obrava-white uppercase mb-4">
              Plan de Mantenimiento
            </h3>
            <p class="text-base sm:text-lg text-obrava-white font-display font-medium leading-relaxed mb-6">
              Para propiedades en alquiler. Una visita mensual, reporte con fotos, y atención prioritaria ante cualquier urgencia. Para que tu Airbnb no se caiga a las 3am.
            </p>
            <ul class="spec-list">
              <li><span>Frecuencia</span><span>Mensual</span></li>
              <li><span>Reporte</span><span>Con fotos</span></li>
              <li><span>Urgencias</span><span>Prioridad 24/7</span></li>
              <li><span>Reparaciones menores</span><span>Incluidas</span></li>
            </ul>
            <a
              href={whatsappLink(mantenimiento.whatsappMsg)}
              class="btn-primary mt-6 self-start"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Preguntar por el plan →
            </a>
          </div>
          <aside class="bg-obrava-black border-4 border-obrava-orange shadow-brutal p-6 sm:p-8 flex flex-col justify-center">
            <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-4">Para hosts de Airbnb y propiedades en alquiler</p>
            <ul class="space-y-3 font-display font-bold text-obrava-white text-lg">
              {mantenimiento.list.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="shrink-0 w-6 h-6 bg-obrava-orange text-obrava-black font-display font-black flex items-center justify-center mt-0.5">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </aside>
        </article>
      </div>
    </div>
  </section>

  <!-- ============== PROCESO · 4 PASOS ============== -->
  <section class="section bg-obrava-orange text-obrava-black" id="proceso">
    <div class="container-brand">
      <div class="text-center mb-12 sm:mb-16">
