---
// src/pages/index.astro
// OBrava · Landing principal (v2.5)
// Hero: AlbanilAnimation en mobile (arriba, escala chica) y desktop (a la derecha, escala grande).
import BaseLayout from '../layouts/BaseLayout.astro';
import AlbanilAnimation from '../components/AlbanilAnimation.astro';

const whatsappLink = (msg: string) =>
  `https://wa.me/5352622265?text=${encodeURIComponent(msg)}`;

const heroWhatsapp = whatsappLink('Hola OBrava, quiero pedir un presupuesto');

const promises = [
  {
    n: '01',
    title: 'Presupuesto claro',
    body: 'Cuánto cuesta, qué incluye y qué no. Por escrito. Sin sorpresas a mitad de obra.',
    highlight: false,
  },
  {
    n: '02',
    title: 'Fecha cierta',
    body: 'Cuándo empezamos y cuándo terminamos. Si nos pasamos, lo compensamos.',
    highlight: true,
  },
  {
    n: '03',
    title: 'Garantía escrita',
    body: '6 meses en mano de obra. 1 año en instalaciones. Si algo falla, volvemos sin coste.',
    highlight: false,
  },
];

type Service = {
  id: string;
  num: string;
  title: string;
  intro: string;
  specs: Array<[string, string]>;
  cta: string;
  proof: { kind: 'quote' | 'stat' | 'list'; quote?: string; attr?: string; stat?: string; statNote?: string; list?: string[] };
  flip: boolean;
  whatsappMsg: string;
  reveal: 'fade-up' | 'fade-left' | 'fade-right' | 'rotate';
};

const services: Service[] = [
  {
    id: 'manitas',
    num: '01',
    title: 'Manitas OBrava',
    intro: 'Para las reparaciones del día a día. Llegas, hablamos, lo arreglamos. Sin formulario, sin esperar tres semanas.',
    specs: [
      ['Plomería', '1 día'],
      ['Electricidad', '1 día'],
      ['Pintura (1 cuarto)', '1–2 días'],
      ['Cerraduras', 'medio día'],
    ],
    cta: 'Pedir Manitas',
    proof: { kind: 'quote', quote: 'Vinieron a cambiar el sifón el mismo día. Lo que otras cuadrillas habrían estirado toda la semana, OBrava lo resolvió en una mañana.', attr: 'Yudith P. · Centro Habana' },
    flip: false,
    whatsappMsg: 'Hola, necesito un Manitas OBrava',
    reveal: 'fade-left',
  },
  {
    id: 'reforma',
    num: '02',
    title: 'Reforma OBrava',
    intro: 'Renovamos baño, cocina, habitación. Materiales incluidos según presupuesto. Te lo entregamos por escrito y por fotos.',
    specs: [
      ['Reforma de baño', '5–10 días'],
      ['Cocina', '1–2 semanas'],
      ['Pisos y Embaldosados', 'según m²'],
      ['Pintura interior', '3–7 días'],
    ],
    cta: 'Pedir Reforma',
    proof: { kind: 'stat', stat: '7 días', statNote: 'reforma de baño completa, sin retrasos' },
    flip: true,
    whatsappMsg: 'Hola, quiero reformar mi baño/cocina/habitación',
    reveal: 'fade-right',
  },
  {
    id: 'ampliacion',
    num: '03',
    title: 'Ampliación OBrava',
    intro: 'Construimos el cuarto, balcón o segundo piso que tu familia necesita. Cimentación, obra gris, techo, instalaciones, entrega.',
    specs: [
      ['Cuarto', '3–5 semanas'],
      ['Balcón', '2–4 semanas'],
      ['Segundo piso', '2–4 meses'],
      ['Techo / cubierta', '1–3 semanas'],
    ],
    cta: 'Pedir Ampliación',
    proof: { kind: 'list', list: ['Cimentación según estudio de suelo', 'Bloques, losa, instalaciones nuevas', 'Permisos y normativas vigentes', 'Garantía estructural de 5 años'] },
    flip: false,
    whatsappMsg: 'Hola, quiero ampliar mi casa',
    reveal: 'fade-left',
  },
  {
    id: 'llave-en-mano',
    num: '04',
    title: 'Llave en Mano',
    intro: 'Para MIPYMES, inversionistas, anfitriones de Airbnb. Entregamos un proyecto completo, hecho, listo para operar.',
    specs: [
      ['Local comercial', 'según proyecto'],
      ['Hostal / Airbnb', 'según proyecto'],
      ['Oficina', 'según proyecto'],
      ['Reforma integral', 'según proyecto'],
    ],
    cta: 'Pedir Llave en Mano',
    proof: { kind: 'quote', quote: 'Reformé la cocina entera. OBrava me enseñó cada paso con fotos. Sin sustos, sin extras. Recomendados 100%.', attr: 'Carlos M. · Playa' },
    flip: true,
    whatsappMsg: 'Hola, busco una obra llave en mano',
    reveal: 'fade-right',
  },
];

const mantenimiento = {
  whatsappMsg: 'Hola, me interesa un plan de mantenimiento OBrava',
  list: [
    'Visita programada cada mes',
    'Reparaciones menores incluidas',
    'Reporte fotográfico al cierre',
    'Atención prioritaria por WhatsApp',
  ],
};

const steps = [
  { n: '01', title: 'Captación', body: 'Nos escribes por WhatsApp. Si tienes foto, mejor.', highlight: false },
  { n: '02', title: 'Visita', body: 'Vamos a la obra, medimos, evaluamos.', highlight: true },
  { n: '03', title: 'Cotización', body: 'Presupuesto por escrito. Sin compromiso.', highlight: false },
  { n: '04', title: 'Entrega', body: 'Construimos en la fecha acordada.', highlight: false },
];

const puntos = [
  { num: '1 punto', copy: 'por cada 100 CUP gastados en una obra.' },
  { num: '+50 puntos', copy: 'por cada referido que cierre obra con nosotros.' },
  { num: '3× puntos', copy: 'en temporada baja (julio y agosto) para nivelar la demanda.' },
  { num: '5% off', copy: 'de por vida si traes a 5 amigos como Embajador OBrava.' },
];

const faqs = [
  { q: '¿Cuánto cuesta la visita para cotizar?', a: 'La visita y el presupuesto son gratis y sin compromiso. Si decides no avanzar, no te cobramos nada. Si avanzamos, el costo de la visita se descuenta del total.' },
  { q: '¿Cómo se paga?', a: 'Aceptamos USD efectivo, CUP, Transfermóvil y remesas (Tropipay, Cuballama). Para obras grandes, 30 % anticipo + 50 % avance + 20 % entrega. Para arreglos chicos, pago al terminar.' },
  { q: '¿Cuánto demora una obra?', a: 'Depende del tamaño. Un arreglo de plomería: 1 día. Una reforma de baño: 5–10 días. Una reforma integral: 4–8 semanas. Te lo decimos claro en el presupuesto.' },
  { q: '¿Y si tengo un problema después de la obra?', a: 'Activamos la garantía OBrava: 6 meses en mano de obra, 1 año en instalaciones. Volvemos sin coste. Sin letra pequeña.' },
  { q: '¿Trabajan en toda La Habana?', a: 'Sí. Toda La Habana y municipios cercanos. Para zonas más alejadas, consultamos.' },
  { q: '¿Y los materiales?', a: 'Dos opciones: (1) los compras tú y nosotros los usamos, o (2) los compramos nosotros y te los pasamos al costo en el presupuesto. Recomendamos la opción 2 para que no pierdas tiempo.' },
];
---

<BaseLayout
  title="OBrava · La brigada que sí aparece"
  description="OBrava · Brigada de construcción en La Habana. Presupuesto claro, fecha cierta, garantía escrita. Manitas, Reforma, Ampliación y Llave en Mano. Escríbenos por WhatsApp: +53 526 222 65."
>

  <!-- ============== HERO ============== -->
  <section class="bg-obrava-black border-b-8 border-obrava-orange relative overflow-hidden">
    <div class="container-brand py-10 sm:py-14 lg:py-20 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="order-2 lg:order-1 lg:col-span-7 relative z-10" data-reveal="fade-up" data-reveal-duration="900">
        <span class="eyebrow" data-reveal="pop" data-reveal-delay="100" data-reveal-duration="500">La brigada que sí aparece</span>
        <h1 class="text-5xl sm:text-6xl lg:text-8xl font-black tracking-tighter leading-[0.9] mb-6 sm:mb-8 text-balance">
          <span class="text-obrava-white">OB</span><span class="text-obrava-orange">RAVA.</span>
          <br />
          <span class="text-obrava-orange text-4xl sm:text-5xl lg:text-7xl">CUMPLIMOS.</span>
        </h1>
        <p class="text-base sm:text-lg lg:text-2xl mb-6 sm:mb-8 text-obrava-white font-bold max-w-xl leading-snug" data-reveal="fade-up" data-reveal-delay="250">
          Presupuesto claro. Fecha cierta. Garantía escrita. Sin excusas.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4" data-reveal="fade-up" data-reveal-delay="400">
          <a href={heroWhatsapp} class="btn-primary">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir Presupuesto Gratis
          </a>
          <a href="#servicios" class="btn-secondary">Ver Servicios</a>
        </div>
        <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mt-5 sm:mt-6" data-reveal="fade-up" data-reveal-delay="550">
          Respondemos en menos de 2h · Visita gratis
        </p>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-5 flex justify-center lg:justify-end items-center relative" data-reveal="scale" data-reveal-duration="900" data-reveal-delay="200">
        <!-- Mobile/tablet: AlbanilAnimation (escala chica, 220-260px) -->
        <div class="lg:hidden border-8 border-obrava-orange shadow-brutal p-2.5 sm:p-3 bg-obrava-black w-[220px] sm:w-[260px]">
          <AlbanilAnimation className="w-full" />
        </div>
        <!-- Desktop: AlbanilAnimation (escala grande, max-w 420px) -->
        <div class="hidden lg:block border-8 border-obrava-orange shadow-brutal p-4 bg-obrava-black w-full max-w-[420px]">
          <AlbanilAnimation className="w-full" />
        </div>
        <div class="absolute -top-4 -right-2 lg:-right-4 bg-obrava-orange text-obrava-black font-display font-black uppercase text-[10px] sm:text-xs px-2 sm:px-3 py-1 border-4 border-obrava-black shadow-brutal-white" data-reveal="rotate" data-reveal-delay="700">
          La Habana · 2026
        </div>
      </div>
    </div>
  </section>

  <!-- ============== PROMESAS ============== -->
  <section class="section bg-obrava-gray" id="promesas">
    <div class="container-brand">
      <div class="text-center mb-10 sm:mb-16">
        <span class="eyebrow" data-reveal="pop" data-reveal-duration="500">Sin excusas</span>
        <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-4 text-obrava-orange text-balance" data-reveal="fade-up" data-reveal-delay="100">
          Nuestras Promesas
        </h2>
        <p class="text-obrava-white font-display font-bold text-base sm:text-xl max-w-2xl mx-auto" data-reveal="fade-up" data-reveal-delay="200">
          Lo que decimos, lo firmamos. Lo que firmamos, lo cumplimos.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-5 sm:gap-8" data-stagger>
        {promises.map((p, i) => (
          <div
            data-reveal="fade-up"
            data-reveal-delay={i * 150}
            data-reveal-duration="900"
            class:list={[
              'reveal-card p-6 sm:p-8 border-4',
              p.highlight
                ? 'bg-obrava-orange text-obrava-black border-obrava-orange shadow-brutal-white md:-translate-y-2 hover:-translate-y-3'
                : 'bg-obrava-black text-obrava-white border-obrava-orange shadow-brutal hover:-translate-y-2',
            ]}
          >
            <div class:list={[
              'w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center mb-5 sm:mb-6 text-2xl sm:text-3xl font-display font-black border-4',
              p.highlight
                ? 'bg-obrava-black text-obrava-orange border-obrava-black'
                : 'bg-obrava-orange text-obrava-black border-obrava-orange',
            ]}>
              {p.n}
            </div>
            <h3 class:list={[
              'text-xl sm:text-2xl md:text-3xl font-display font-black mb-3 sm:mb-4 uppercase',
              p.highlight ? 'text-obrava-black' : 'text-obrava-white',
            ]}>{p.title}</h3>
            <p class:list={[
              'text-sm sm:text-base md:text-lg leading-relaxed font-display',
              p.highlight ? 'text-obrava-black font-bold' : 'text-obrava-white font-medium',
            ]}>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== SERVICIOS · SPLIT DIPTYCH ============== -->
  <section class="section bg-obrava-black" id="servicios">
    <div class="container-brand">
      <div class="mb-10 sm:mb-16 flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6">
        <div>
          <span class="eyebrow" data-reveal="pop">Lo que hacemos</span>
          <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-3 sm:mb-4 text-obrava-orange text-balance" data-reveal="fade-up" data-reveal-delay="100">
            Servicios Técnicos
          </h2>
          <p class="text-obrava-white font-display font-bold text-base sm:text-xl max-w-2xl" data-reveal="fade-up" data-reveal-delay="200">
            Cinco paquetes. Todos con la misma promesa: presupuesto claro, fecha cierta, garantía escrita.
          </p>
        </div>
      </div>

      <div class="space-y-10 sm:space-y-14">
        {services.map((s) => (
          <article
            id={s.id}
            data-reveal={s.reveal}
            data-reveal-duration="1000"
            class:list={[
              'grid lg:grid-cols-2 gap-5 sm:gap-8 lg:gap-10 items-stretch',
              s.flip ? 'lg:[&>:first-child]:order-2' : '',
            ]}
          >
            <div class="bg-obrava-gray border-4 border-obrava-orange p-5 sm:p-8 shadow-brutal flex flex-col reveal-card">
              <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-3">
                {s.num} · Servicio
              </p>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-display font-black text-obrava-white uppercase mb-4">
                {s.title}
              </h3>
              <p class="text-sm sm:text-base text-obrava-white font-display font-medium leading-relaxed mb-5 sm:mb-6">
                {s.intro}
              </p>
              <ul class="spec-list">
                {s.specs.map(([label, value]) => (
                  <li>
                    <span>{label}</span>
                    <span>{value}</span>
                  </li>
                ))}
              </ul>
              <a
                href={whatsappLink(s.whatsappMsg)}
                class="btn-primary mt-5 sm:mt-6 self-start"
                aria-label={`Pedir ${s.title} por WhatsApp`}
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                </svg>
                {s.cta} →
              </a>
            </div>

            <aside class="bg-obrava-orange text-obrava-black border-4 border-obrava-orange shadow-brutal p-5 sm:p-8 flex flex-col justify-center reveal-card">
              {s.proof.kind === 'quote' && (
                <>
                  <p class="proof-quote">{s.proof.quote}</p>
                  <p class="proof-attr"><strong>{s.proof.attr}</strong></p>
                </>
              )}
              {s.proof.kind === 'stat' && (
                <div>
                  <p class="font-display font-black text-6xl sm:text-7xl lg:text-8xl leading-none text-obrava-black tracking-tighter">
                    {s.proof.stat}
                  </p>
                  <p class="font-display font-bold text-base sm:text-lg mt-3 sm:mt-4 max-w-sm">{s.proof.statNote}</p>
                </div>
              )}
              {s.proof.kind === 'list' && (
                <>
                  <p class="font-mono text-xs uppercase tracking-wider text-obrava-black mb-4">Incluye</p>
                  <ul class="space-y-2.5 sm:space-y-3 font-display font-bold text-obrava-black text-base sm:text-lg">
                    {s.proof.list?.map((item) => (
                      <li class="flex items-start gap-3">
                        <span class="shrink-0 w-6 h-6 bg-obrava-black text-obrava-orange font-display font-black flex items-center justify-center mt-0.5">✓</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
            </aside>
          </article>
        ))}

        <article id="mantenimiento" data-reveal="fade-up" data-reveal-duration="1000" class="grid lg:grid-cols-2 gap-5 sm:gap-8 lg:gap-10 items-stretch">
          <div class="bg-obrava-gray border-4 border-obrava-orange p-5 sm:p-8 shadow-brutal flex flex-col reveal-card">
            <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-3">05 · Plan recurrente</p>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-display font-black text-obrava-white uppercase mb-4">
              Plan de Mantenimiento
            </h3>
            <p class="text-sm sm:text-base text-obrava-white font-display font-medium leading-relaxed mb-5 sm:mb-6">
              Para propiedades en alquiler. Una visita mensual, reporte con fotos, y atención prioritaria ante cualquier urgencia. Para que tu Airbnb no se caiga a las 3am.
            </p>
            <ul class="spec-list">
              <li><span>Frecuencia</span><span>Mensual</span></li>
              <li><span>Reporte</span><span>Con fotos</span></li>
              <li><span>Urgencias</span><span>Prioridad 24/7</span></li>
              <li><span>Reparaciones menores</span><span>Incluidas</span></li>
            </ul>
            <a
              href={whatsappLink(mantenimiento.whatsappMsg)}
              class="btn-primary mt-5 sm:mt-6 self-start"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Preguntar por el plan →
            </a>
          </div>
          <aside class="bg-obrava-black border-4 border-obrava-orange shadow-brutal p-5 sm:p-8 flex flex-col justify-center reveal-card">
            <p class="font-mono text-xs uppercase tracking-wider text-obrava-orange mb-4">Para hosts de Airbnb y propiedades en alquiler</p>
            <ul class="space-y-2.5 sm:space-y-3 font-display font-bold text-obrava-white text-base sm:text-lg">
              {mantenimiento.list.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="shrink-0 w-6 h-6 bg-obrava-orange text-obrava-black font-display font-black flex items-center justify-center mt-0.5">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </aside>
        </article>
      </div>
    </div>
  </section>

  <!-- ============== PROCESO ============== -->
  <section class="section bg-obrava-orange text-obrava-black" id="proceso">
    <div class="container-brand">
      <div class="text-center mb-10 sm:mb-16">
        <span class="inline-block bg-obrava-black text-obrava-orange font-mono text-xs uppercase tracking-wider px-3 py-1 border-2 border-obrava-black mb-4" data-reveal="pop">El protocolo</span>
        <h2 class="text-3xl sm:text-4xl lg:text-6xl font-black tracking-tight mb-3 sm:mb-4 text-obrava-black text-balance" data-reveal="fade-up" data-reveal-delay="100">
          Cómo Trabajamos
        </h2>
        <p class="text-obrava-black font-display font-bold text-base sm:text-xl max-w-2xl mx-auto" data-reveal="fade-up" data-reveal-delay="200">
          Cuatro pasos, del WhatsApp a la obra entregada.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-6 relative" data-stagger>
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-2 bg-obrava-black -z-10 transform -translate-y-1/2"></div>
        {steps.map((s) => (
          <div
            data-reveal="pop"
            data-reveal-duration="700"
            class:list={[
              'p-4 sm:p-6 text-center border-4 reveal-card',
              s.highlight
                ? 'bg-obrava-black text-obrava-white border-obrava-black scale-105 shadow-brutal-white'
                : 'bg-obrava-white text-obrava-black border-obrava-black',
            ]}
          >
            <div class:list={[
              'w-12 h-12 sm:w-14 sm:h-14 font-display font-black flex items-center justify-center mx-auto mb-3 sm:mb-4 text-xl sm:text-2xl border-4',
              s.highlight
                ? 'bg-obrava-orange text-obrava-black border-obrava-orange shadow-brutal-small-white'
                : 'bg-obrava-black text-obrava-orange border-obrava-black',
            ]}>{s.n}</div>
            <h3 class="text-base sm:text-xl md:text-2xl font-display font-black mb-1.5 sm:mb-2 uppercase">{s.title}</h3>
            <p class:list={[
              'text-xs sm:text-sm md:text-base font-display',
              s.highlight ? 'text-obrava-white font-medium' : 'text-obrava-black font-bold',
            ]}>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============== PUNTOS EMBAJADORES ============== -->
  <section class="section bg-obrava-black" id="puntos">
    <div class="container-brand">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div>
          <span class="inline-block bg-obrava-orange text-obrava-black font-mono text-xs uppercase tracking-wider px-3 py-1 border-2 border-obrava-orange mb-4" data-reveal="pop">Embajadores OBrava</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 sm:mb-6 text-obrava-white text-balance" data-reveal="fade-up" data-reveal-delay="100">
