            data-reveal-duration="700"
            class="group bg-obrava-black border-4 border-obrava-orange shadow-brutal p-4 sm:p-6 cursor-pointer reveal-card"
          >
            <summary class="flex justify-between items-center font-display font-black text-base sm:text-xl md:text-2xl text-obrava-white uppercase list-none gap-3 sm:gap-4">
              <span class="text-balance">{faq.q}</span>
              <span class="material-symbols-outlined transition-transform duration-300 border-4 border-obrava-orange bg-obrava-orange text-obrava-black p-1 font-black shrink-0 group-open:rotate-180" style="font-variation-settings: 'FILL' 0, 'wght' 600, 'GRAD' 0, 'opsz' 48;" aria-hidden="true">
                expand_more
              </span>
            </summary>
            <div class="mt-3 sm:mt-4 text-obrava-white font-display font-medium leading-relaxed bg-obrava-gray p-4 sm:p-6 border-4 border-obrava-orange text-sm sm:text-base md:text-lg">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

