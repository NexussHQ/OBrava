---
// src/pages/nosotros.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const whatsappLink = (msg: string) =>
  `https://wa.me/5352622265?text=${encodeURIComponent(msg)}`;

const values = [
  {
    n: '01',
    title: 'Cumplimos lo que decimos',
    body: 'La mayoría de los competidores no da fecha, no da precio, no da garantía. Nosotros sí. Por escrito.',
  },
  {
    n: '02',
    title: 'Por escrito, no por palabra',
    body: 'Cada obra, cada presupuesto, cada garantía se firma. Sin sorpresas, sin letra pequeña.',
  },
  {
    n: '03',
    title: 'Equipo verificado',
    body: 'Cuadrillas con las que hemos trabajado. No contratamos desconocidos. La calidad no se negocia.',
  },
];

const stats = [
  { n: '6', label: 'Meses de Garantía', suffix: 'm' },
  { n: '12', label: 'Meses en Instalaciones', suffix: 'm' },
  { n: '24/7', label: 'Atención por WhatsApp', suffix: '' },
  { n: '<2h', label: 'Tiempo de Respuesta', suffix: '' },
];
---

<BaseLayout
  title="Nosotros"
  description="OBrava · La brigada que sí aparece. Conoce nuestra historia, valores y compromiso con el cumplimiento en La Habana, Cuba."
>
  <section class="bg-obrava-black border-b-8 border-obrava-orange py-12 sm:py-16">
    <div class="container-brand">
      <span class="eyebrow">Sobre nosotros</span>
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-black tracking-tighter mb-4 sm:mb-6 text-balance">
        <span class="text-obrava-white">La brigada que </span><span class="text-obrava-orange">sí aparece.</span>
      </h1>
      <p class="text-lg sm:text-xl text-obrava-white font-display font-bold max-w-3xl">
        Construir en La Habana exige algo más que buenas manos: exige confianza. OBrava nació para cerrar la brecha entre lo que se promete y lo que se cumple.
      </p>
    </div>
  </section>

  <section class="section bg-obrava-gray">
    <div class="container-brand grid lg:grid-cols-2 gap-10 lg:gap-12">
      <div>
        <span class="eyebrow">El problema</span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-6 text-obrava-orange text-balance">
          Conseguir una buena brigada en La Habana es difícil.
        </h2>
        <p class="text-base sm:text-lg text-obrava-white font-display font-medium mb-4 leading-relaxed">
          La mayoría de los competidores informales no da cotización formal, no entrega presupuesto por escrito, no fecha de inicio, no fecha de entrega, no garantía. Te prometen "mañana empezamos" y desaparecen.
        </p>
        <p class="text-base sm:text-lg text-obrava-white font-display font-medium leading-relaxed">
          Y si la obra sale mal, no hay con quién reclamarla. Solo te queda aceptar el resultado o pelear meses.
        </p>
      </div>
      <div>
        <span class="eyebrow">Nuestra respuesta</span>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight mb-6 text-obrava-orange text-balance">
          Cumplir lo que decimos, por escrito.
        </h2>
        <p class="text-base sm:text-lg text-obrava-white font-display font-medium mb-4 leading-relaxed">
          OBrava opera con tres reglas inquebrantables: presupuesto claro, fecha cierta, garantía escrita. Cada obra tiene un contrato firmado, una fecha de inicio, una fecha de entrega, y una garantía de 6 meses en mano de obra y 1 año en instalaciones.
        </p>
        <p class="text-base sm:text-lg text-obrava-white font-display font-medium leading-relaxed">
          No somos la brigada más barata. Somos la brigada que responde, cumple y respalda su trabajo.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-obrava-black">
    <div class="container-brand">
      <div class="text-center mb-12 sm:mb-16">
        <span class="eyebrow">Lo que creemos</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 text-obrava-orange text-balance">
          Nuestros valores
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6 sm:gap-8">
        {values.map((v) => (
          <div class="bg-obrava-gray p-6 sm:p-8 border-4 border-obrava-orange shadow-brutal">
            <div class="font-mono text-sm uppercase tracking-wider text-obrava-orange mb-4">{v.n}</div>
            <h3 class="text-2xl font-display font-black mb-4 text-obrava-white uppercase">{v.title}</h3>
            <p class="text-base sm:text-lg text-obrava-white font-display font-medium leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-obrava-orange text-obrava-black">
    <div class="container-brand">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        {stats.map((s) => (
          <div class="bg-obrava-black border-4 border-obrava-black p-4 sm:p-6 text-center">
            <p class="text-4xl sm:text-5xl font-display font-black text-obrava-orange mb-2">{s.n}{s.suffix}</p>
            <p class="font-mono text-xs uppercase tracking-wider text-obrava-white">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-obrava-black py-16 sm:py-20">
    <div class="container-brand text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight mb-4 sm:mb-6 uppercase text-obrava-white text-balance">
        ¿Listo para trabajar con nosotros?
      </h2>
      <p class="text-lg sm:text-xl mb-8 font-display font-bold max-w-2xl mx-auto text-obrava-white">
        Cuéntanos qué necesitas. Te respondemos en menos de 2 horas.
      </p>
      <a href={whatsappLink('Hola OBrava, quiero conocerlos')} class="btn-primary">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Hablar por WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
